	(text "For Master SPI config,\nM[0..1] need to be 01\n(M0=1, M1=0) - doing this with '125 when DONE is low\nM[] are sampled when INIT_B goes high, std I/O after config\nDONE goes high after initialization is finished.\nBoot PROM connections:\nMOSI is SPI MOSI\nDIN is SPI MISO\nCSO_B is Boot flash /select\nCCLK is SPI clock\n(CCLK is 50 Ohm transmission line\n- no branches 100/100 termination)"
		(exclude_from_sim no)
		(at 127 200.66 0)
		(effects
			(font
				(size 1.778 1.5113)
			)
			(justify left bottom)
		)
		(uuid "1084ae29-6d64-4d87-b6f7-dcabd1fdaef3")
	)
