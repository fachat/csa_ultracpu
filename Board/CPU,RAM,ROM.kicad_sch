	(text "Fast RAM\n"
		(exclude_from_sim no)
		(at 62.23 247.65 0)
		(effects
			(font
				(size 2.54 2.159)
			)
			(justify left bottom)
		)
		(uuid "7e05716d-e160-471e-a97c-c72611e1837a")
	)
	(text "V2.0A:\n- use CCLK for all SPI clocks\n- add switchable CPU BE input\n- VCCAUX is 3.3V now\n- Added test points\nV2.0B:\n- IC6 power supply to 3.3V instead of 5V\n- Pulldown /RES as long as DONE is low\nV2.1A:\n- use TSOP-II 44 pin package for SRAM\n- use 3225 package for 54MHz SMD oscillator\nV3.0A:\n- go from VGA to HDMI\n- go to larger FPGA in BGA package,\n  move FPGA to own page\n- use 16bit Fast RAM IC"
		(exclude_from_sim no)
		(at 326.39 241.3 0)
		(effects
			(font
				(size 2.54 2.159)
			)
			(justify left bottom)
		)
		(uuid "e48ff904-e5eb-4ff7-822f-6e10ce7f722c")
	)
